[Unit]
Description=UNBOUND API and dashboard
After=network-online.target
Wants=network-online.target
[Service]
User=unbound
Group=unbound
WorkingDirectory=/opt/unbound
EnvironmentFile=/etc/unbound/environment
ExecStart=/opt/unbound/.venv/bin/uvicorn unbound.api:app --host 127.0.0.1 --port 8000 --no-proxy-headers
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/unbound
[Install]
WantedBy=multi-user.target
