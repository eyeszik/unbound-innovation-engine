# Default is a live provider. Missing credentials cause an actionable error.
UNBOUND_PROVIDER=openai
UNBOUND_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# For an OpenAI-compatible endpoint, set provider=compatible and both values:
UNBOUND_BASE_URL=
UNBOUND_API_KEY=
# Explicit offline demonstration only: UNBOUND_PROVIDER=mock; UNBOUND_MODEL=mock-v1
UNBOUND_DB=data/unbound.sqlite
UNBOUND_CHECKPOINT_DB=data/checkpoints.sqlite
UNBOUND_CALL_TIMEOUT=120
UNBOUND_ATTEMPTS=3
UNBOUND_WORKER_CONCURRENCY=1
# Required for access beyond loopback. Use HTTPS gateway + owner password.
UNBOUND_OWNER_PASSWORD=
# Required behind TLS termination for same-origin POST checks, without trailing slash:
UNBOUND_PUBLIC_ORIGIN=
EXA_API_KEY=
WOLFRAM_APP_ID=
